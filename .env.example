# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon PostgreSQL connection string (include sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Long random value (32+ chars). Signs the guest session cookie.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# ---------------------------------------------------------------------------
# Deployment provider (Vercel) — server-side only, never expose to the browser
# ---------------------------------------------------------------------------
# Personal/team token used to create deployments and map domains.
DEPLOY_API_TOKEN=""
# Team id that owns the deployments (optional for personal accounts).
DEPLOY_TEAM_ID=""
# Set to "false" to disable provider calls (upload will only validate metadata).
DEPLOY_ENABLED="true"
# "production" or "preview"
DEPLOY_TARGET="production"

# The dashboard itself lives in its own Vercel project. User projects are
# created as separate Vercel projects and must NOT reuse the dashboard project.
DASHBOARD_VERCEL_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Domains
# ---------------------------------------------------------------------------
MAIN_DOMAIN="freehost.my.id"
PROJECT_DOMAIN="host.my.id"

# ---------------------------------------------------------------------------
# Quotas (server-enforced; tune without changing UI code)
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES="50000000"
QUOTA_GUEST_PROJECTS="2"
QUOTA_GUEST_DEPLOYS_PER_DAY="5"
QUOTA_USER_PROJECTS="10"
QUOTA_USER_DEPLOYS_PER_DAY="50"
