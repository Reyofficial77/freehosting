# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Set to a long random value before using guest sessions in production
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Vercel token/team/project settings are intentionally server-only.
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_PROJECT_ID=""
# Optional upload limits (bytes); default 4 MiB compressed
MAX_UPLOAD_BYTES="4194304"
